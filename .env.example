# DIP Environment Configuration

# Application
DIP_ENV=development
DIP_DEBUG=true
DIP_LOG_LEVEL=INFO
DIP_API_HOST=0.0.0.0
DIP_API_PORT=8000

# PostgreSQL
DIP_POSTGRES_HOST=localhost
DIP_POSTGRES_PORT=5432
DIP_POSTGRES_DB=dip
DIP_POSTGRES_USER=dip
DIP_POSTGRES_PASSWORD=dip_secret

# Kafka
DIP_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DIP_KAFKA_EVENTS_TOPIC=dip-events
DIP_KAFKA_DLQ_TOPIC=dip-dlq
DIP_KAFKA_CONSUMER_GROUP=dip-processor

# Elasticsearch
DIP_ELASTICSEARCH_HOST=localhost
DIP_ELASTICSEARCH_PORT=9200
DIP_ELASTICSEARCH_SCHEME=http

# Redis
DIP_REDIS_HOST=localhost
DIP_REDIS_PORT=6379

# Observability
DIP_PROMETHEUS_PORT=9090
DIP_METRICS_ENABLED=true

# Backend Selection (memory | kafka | elasticsearch | redis)
DIP_EVENT_BACKEND=memory
DIP_SEARCH_BACKEND=memory
DIP_CACHE_BACKEND=memory

# API Security (comma-separated API keys for production)
DIP_API_KEYS=

# CORS Origins (comma-separated origins, or * for all)
DIP_CORS_ORIGINS=*
